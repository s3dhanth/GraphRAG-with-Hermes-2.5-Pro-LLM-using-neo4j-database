@prefix : <http://neo4j.com/voc/banking#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://neo4j.com/voc/banking#> .

<http://neo4j.com/voc/banking#> rdf:type owl:Ontology ;
                                owl:imports <https://schema.org/version/latest/schemaorg-current-https.ttl> .

#################################################################
#    Classes (Nodes)
#################################################################

###  Bank
:Bank rdf:type owl:Class ;
      rdfs:comment "A financial institution that operates under regulations." .

###  Regulation
:Regulation rdf:type owl:Class ;
            rdfs:comment "Rules imposed by authorities to ensure financial stability." .

###  Risk
:Risk rdf:type owl:Class ;
      rdfs:comment "Potential threats affecting financial institutions." .

###  LiquidityRisk
:LiquidityRisk rdf:type owl:Class ;
               rdfs:subClassOf :Risk ;
               rdfs:comment "Risk of a bank not having enough liquidity." .

###  CreditRisk
:CreditRisk rdf:type owl:Class ;
            rdfs:subClassOf :Risk ;
            rdfs:comment "Risk of a borrower failing to meet obligations." .

###  MarketRisk
:MarketRisk rdf:type owl:Class ;
            rdfs:subClassOf :Risk ;
            rdfs:comment "Risk of financial loss due to market fluctuations." .

###  CounterpartyRisk
:CounterpartyRisk rdf:type owl:Class ;
                  rdfs:subClassOf :Risk ;
                  rdfs:comment "Risk arising from counterparty default." .

###  CapitalRequirement
:CapitalRequirement rdf:type owl:Class ;
                    rdfs:comment "Minimum capital a bank must hold to reduce risk." .

###  LiquidityStandard
:LiquidityStandard rdf:type owl:Class ;
                   rdfs:comment "Regulation ensuring a bank has sufficient liquidity." .

###  StressTesting
:StressTesting rdf:type owl:Class ;
               rdfs:comment "Risk management process assessing financial stability." .

#################################################################
#    Object Properties (Relationships)
#################################################################

###  compliesWith
:compliesWith rdf:type owl:ObjectProperty ;
              rdfs:domain :Bank ;
              rdfs:range :Regulation ;
              rdfs:comment "A bank follows a regulation." .

###  addresses
:addresses rdf:type owl:ObjectProperty ;
           rdfs:domain :Regulation ;
           rdfs:range :Risk ;
           rdfs:comment "A regulation mitigates a financial risk." .

###  setsCapitalRequirement
:setsCapitalRequirement rdf:type owl:ObjectProperty ;
                        rdfs:domain :Regulation ;
                        rdfs:range :CapitalRequirement ;
                        rdfs:comment "A regulation defines the capital requirement." .

###  setsLiquidityStandard
:setsLiquidityStandard rdf:type owl:ObjectProperty ;
                       rdfs:domain :Regulation ;
                       rdfs:range :LiquidityStandard ;
                       rdfs:comment "A regulation establishes liquidity buffer requirements." .

###  assessesRisk
:assessesRisk rdf:type owl:ObjectProperty ;
              rdfs:domain :StressTesting ;
              rdfs:range :Risk ;
              rdfs:comment "Stress testing evaluates financial risk." .

###  managesCounterpartyRisk
:managesCounterpartyRisk rdf:type owl:ObjectProperty ;
                         rdfs:domain :Bank ;
                         rdfs:range :CounterpartyRisk ;
                         rdfs:comment "A bank manages counterparty risk." .
