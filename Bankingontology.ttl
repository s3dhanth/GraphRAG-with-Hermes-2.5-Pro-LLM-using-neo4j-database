@prefix : <http://www.semanticweb.org/ashut/ontologies/2025/2/banking#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

@base <http://www.semanticweb.org/ashut/ontologies/2025/2/banking#> .

<http://www.semanticweb.org/ashut/ontologies/2025/2/banking> rdf:type owl:Ontology .

#################################################################
#    Classes (Node Labels)
#################################################################

:Bank rdf:type owl:Class ;
      rdfs:comment "A financial institution that operates under regulations." .

:Regulation rdf:type owl:Class ;
            rdfs:comment "Rules and guidelines imposed by authorities to ensure financial stability." .

:Risk rdf:type owl:Class ;
      rdfs:comment "Potential threats or uncertainties affecting financial institutions." .

:CounterpartyRisk rdf:type owl:Class ;
                  rdfs:subClassOf :Risk ;
                  rdfs:comment "Risk of counterparty default in transactions." .

:LiquidityRisk rdf:type owl:Class ;
               rdfs:subClassOf :Risk ;
               rdfs:comment "Risk that a bank lacks liquidity to meet obligations." .

:StressTesting rdf:type owl:Class ;
               rdfs:comment "Process to assess financial institution stability under stress." .

#################################################################
#    Object Properties (Relationships)
#################################################################

:compliesWith rdf:type owl:ObjectProperty ;
              rdfs:domain :Bank ;
              rdfs:range :Regulation ;
              rdfs:comment "A bank follows a regulation." .

:assessesRisk rdf:type owl:ObjectProperty ;
              rdfs:domain :StressTesting ;
              rdfs:range :Risk ;
              rdfs:comment "Stress testing evaluates risks." .

:manageCounterpartyRisk rdf:type owl:ObjectProperty ;
                        rdfs:domain :Bank ;
                        rdfs:range :CounterpartyRisk ;
                        rdfs:comment "A bank manages counterparty risk." .

:setsLiquidityStandard rdf:type owl:ObjectProperty ;
                       rdfs:domain :Regulation ;
                       rdfs:range :LiquidityRisk ;
                       rdfs:comment "A regulation sets liquidity risk standards." .

#################################################################
#    Instances (Example Data)
#################################################################

:BankA rdf:type owl:NamedIndividual , :Bank ;
       :compliesWith :RegulationX .

:RegulationX rdf:type owl:NamedIndividual , :Regulation ;
             :setsLiquidityStandard :LiquidityRiskA .

:LiquidityRiskA rdf:type owl:NamedIndividual , :LiquidityRisk .
