@prefix : <http://neo4j.com/voc/banking#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

@base <http://neo4j.com/voc/banking#> .

<http://neo4j.com/voc/banking#> rdf:type owl:Ontology .

### Define Classes with Neo4j Labels
:Bank rdf:type owl:Class ;
      rdfs:label "Bank" ;
      rdfs:comment "A financial institution that operates under regulations." .

:Regulation rdf:type owl:Class ;
            rdfs:label "Regulation" ;
            rdfs:comment "Rules and guidelines imposed by authorities to ensure financial stability." .

:Risk rdf:type owl:Class ;
      rdfs:label "Risk" ;
      rdfs:comment "Potential threats or uncertainties affecting financial institutions." .

:LiquidityRisk rdf:type owl:Class ;
               rdfs:label "LiquidityRisk" ;
               rdfs:subClassOf :Risk .

:CreditRisk rdf:type owl:Class ;
            rdfs:label "CreditRisk" ;
            rdfs:subClassOf :Risk .

:MarketRisk rdf:type owl:Class ;
            rdfs:label "MarketRisk" ;
            rdfs:subClassOf :Risk .

:CounterpartyRisk rdf:type owl:Class ;
                  rdfs:label "CounterpartyRisk" ;
                  rdfs:subClassOf :Risk .

:CapitalRequirement rdf:type owl:Class ;
                    rdfs:label "CapitalRequirement" .

:LiquidityStandard rdf:type owl:Class ;
                   rdfs:label "LiquidityStandard" .

:StressTesting rdf:type owl:Class ;
               rdfs:label "StressTesting" .

### Relationships (Object Properties)
:compliesWith rdf:type owl:ObjectProperty ;
              rdfs:domain :Bank ;
              rdfs:range :Regulation ;
              rdfs:label "COMPLIES_WITH" .

:addresses rdf:type owl:ObjectProperty ;
           rdfs:domain :Regulation ;
           rdfs:range :Risk ;
           rdfs:label "ADDRESSES" .

:setsCapitalRequirement rdf:type owl:ObjectProperty ;
                        rdfs:domain :Regulation ;
                        rdfs:range :CapitalRequirement ;
                        rdfs:label "SETS_CAPITAL_REQUIREMENT" .

:setsLiquidityStandard rdf:type owl:ObjectProperty ;
                       rdfs:domain :Regulation ;
                       rdfs:range :LiquidityStandard ;
                       rdfs:label "SETS_LIQUIDITY_STANDARD" .

:assessesRisk rdf:type owl:ObjectProperty ;
              rdfs:domain :StressTesting ;
              rdfs:range :Risk ;
              rdfs:label "ASSESSES_RISK" .

:managesCounterpartyRisk rdf:type owl:ObjectProperty ;
                         rdfs:domain :Bank ;
                         rdfs:range :CounterpartyRisk ;
                         rdfs:label "MANAGES_COUNTERPARTY_RISK" .
