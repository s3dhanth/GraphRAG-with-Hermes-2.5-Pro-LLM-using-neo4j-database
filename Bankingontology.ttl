@prefix : <http://neo4j.com/voc/banking#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@base <http://neo4j.com/voc/banking#> .

<http://neo4j.com/voc/banking#> rdf:type owl:Ontology ;
                             owl:imports <https://schema.org/version/latest/schemaorg-current-https.ttl> .

#################################################################
#    Classes
#################################################################

###  Bank
:Bank rdf:type owl:Class ;
      rdfs:subClassOf schema:BankOrCreditUnion ;
      rdfs:comment "A financial institution that operates under regulations." .

###  Regulation
:Regulation rdf:type owl:Class ;
            rdfs:comment "A set of rules that banks must comply with." .

###  Risk
:Risk rdf:type owl:Class ;
      rdfs:comment "A potential financial uncertainty that banks must manage." .

###  LiquidityRisk
:LiquidityRisk rdf:type owl:Class ;
              rdfs:subClassOf :Risk ;
              rdfs:comment "Risk related to liquidity issues." .

###  CreditRisk
:CreditRisk rdf:type owl:Class ;
           rdfs:subClassOf :Risk ;
           rdfs:comment "Risk related to borrowers defaulting on loans." .

###  MarketRisk
:MarketRisk rdf:type owl:Class ;
           rdfs:subClassOf :Risk ;
           rdfs:comment "Risk arising from market fluctuations." .

###  CounterpartyRisk
:CounterpartyRisk rdf:type owl:Class ;
                 rdfs:subClassOf :Risk ;
                 rdfs:comment "Risk of default by a counterparty in financial transactions." .

###  CapitalRequirement
:CapitalRequirement rdf:type owl:Class ;
                    rdfs:comment "Minimum capital reserves required for a bank." .

###  LiquidityStandard
:LiquidityStandard rdf:type owl:Class ;
                   rdfs:comment "Liquidity standards banks must adhere to." .

###  StressTesting
:StressTesting rdf:type owl:Class ;
               rdfs:comment "Evaluation of a bank’s ability to handle financial stress." .

#################################################################
#    Object Properties (Relationships)
#################################################################

###  compliesWith (Bank → Regulation)
:compliesWith rdf:type owl:ObjectProperty ;
              rdfs:domain :Bank ;
              rdfs:range :Regulation ;
              rdfs:comment "Indicates that a bank complies with a regulation." .

###  addresses (Regulation → Risk)
:addresses rdf:type owl:ObjectProperty ;
           rdfs:domain :Regulation ;
           rdfs:range :Risk ;
           rdfs:comment "Regulation addresses a certain type of risk." .

###  setsCapitalRequirement (Regulation → CapitalRequirement)
:setsCapitalRequirement rdf:type owl:ObjectProperty ;
                         rdfs:domain :Regulation ;
                         rdfs:range :CapitalRequirement ;
                         rdfs:comment "Regulation sets capital requirements." .

###  setsLiquidityStandard (Regulation → LiquidityStandard)
:setsLiquidityStandard rdf:type owl:ObjectProperty ;
                        rdfs:domain :Regulation ;
                        rdfs:range :LiquidityStandard ;
                        rdfs:comment "Regulation sets liquidity standards." .

###  assessesRisk (StressTesting → Risk)
:assessesRisk rdf:type owl:ObjectProperty ;
              rdfs:domain :StressTesting ;
              rdfs:range :Risk ;
              rdfs:comment "Stress testing assesses different types of risk." .

###  managesCounterpartyRisk (Bank → CounterpartyRisk)
:managesCounterpartyRisk rdf:type owl:ObjectProperty ;
                          rdfs:domain :Bank ;
                          rdfs:range :CounterpartyRisk ;
                          rdfs:comment "A bank manages counterparty risk." .

#################################################################
#    Data Properties
#################################################################

###  entityLabel (for better Neo4j integration)
:entityLabel rdf:type owl:DatatypeProperty ;
             rdfs:domain :Bank , :Regulation , :Risk , :LiquidityRisk , :CreditRisk , :MarketRisk , :CounterpartyRisk , :CapitalRequirement , :LiquidityStandard , :StressTesting ;
             rdfs:range xsd:string ;
             rdfs:comment "A human-readable label for entities in Neo4j." .
