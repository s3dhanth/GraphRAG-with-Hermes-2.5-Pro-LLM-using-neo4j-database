@prefix : <http://neo4j.com/voc/banking#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@base <http://neo4j.com/voc/banking#> .

<http://neo4j.com/voc/banking#> rdf:type owl:Ontology ;
    owl:imports <https://schema.org/version/latest/schemaorg-current-https.ttl> .

#################################################################
#    Classes
#################################################################

###  Bank
:Bank rdf:type owl:Class ;
      rdfs:subClassOf schema:BankOrCreditUnion ;
      rdfs:comment "A financial institution that operates under regulations." .

###  Regulation
:Regulation rdf:type owl:Class ;
      rdfs:comment "A set of rules governing financial institutions." .

###  Risk
:Risk rdf:type owl:Class ;
      rdfs:subClassOf schema:RiskFactor ;
      rdfs:comment "A factor affecting financial stability." .

###  LiquidityRisk
:LiquidityRisk rdf:type owl:Class ;
      rdfs:subClassOf :Risk ;
      rdfs:comment "The risk that an entity cannot meet short-term obligations." .

###  CreditRisk
:CreditRisk rdf:type owl:Class ;
      rdfs:subClassOf :Risk ;
      rdfs:comment "The risk of a borrower defaulting on a loan." .

###  MarketRisk
:MarketRisk rdf:type owl:Class ;
      rdfs:subClassOf :Risk ;
      rdfs:comment "The risk of financial losses due to market fluctuations." .

###  CounterpartyRisk
:CounterpartyRisk rdf:type owl:Class ;
      rdfs:subClassOf :Risk ;
      rdfs:comment "The risk that the counterparty in a transaction defaults." .

###  CapitalRequirement
:CapitalRequirement rdf:type owl:Class ;
      rdfs:comment "The minimum amount of capital a bank must hold as per regulation." .

###  LiquidityStandard
:LiquidityStandard rdf:type owl:Class ;
      rdfs:comment "Regulatory requirements ensuring liquidity in financial institutions." .

###  StressTesting
:StressTesting rdf:type owl:Class ;
      rdfs:subClassOf schema:FinancialService ;
      rdfs:comment "A simulation technique to evaluate financial risk." .

#################################################################
#    Object Properties (Relationships)
#################################################################

###  compliesWith (Bank → Regulation)
:compliesWith rdf:type owl:ObjectProperty ;
      rdfs:domain :Bank ;
      rdfs:range :Regulation ;
      rdfs:comment "Indicates a bank's compliance with a regulation." .

###  addresses (Regulation → Risk)
:addresses rdf:type owl:ObjectProperty ;
      rdfs:domain :Regulation ;
      rdfs:range :Risk ;
      rdfs:comment "Indicates which risks a regulation addresses." .

###  setsCapitalRequirement (Regulation → CapitalRequirement)
:setsCapitalRequirement rdf:type owl:ObjectProperty ;
      rdfs:domain :Regulation ;
      rdfs:range :CapitalRequirement ;
      rdfs:comment "Defines the capital requirements set by regulations." .

###  setsLiquidityStandard (Regulation → LiquidityStandard)
:setsLiquidityStandard rdf:type owl:ObjectProperty ;
      rdfs:domain :Regulation ;
      rdfs:range :LiquidityStandard ;
      rdfs:comment "Defines the liquidity standards set by regulations." .

###  assessesRisk (StressTesting → Risk)
:assessesRisk rdf:type owl:ObjectProperty ;
      rdfs:domain :StressTesting ;
      rdfs:range :Risk ;
      rdfs:comment "Indicates that stress testing assesses financial risks." .

###  managesCounterpartyRisk (Bank → CounterpartyRisk)
:managesCounterpartyRisk rdf:type owl:ObjectProperty ;
      rdfs:domain :Bank ;
      rdfs:range :CounterpartyRisk ;
      rdfs:comment "Indicates that a bank manages counterparty risk." .
