@prefix : <http://neo4j.com/voc/banking#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@base <http://neo4j.com/voc/banking#> .

<http://neo4j.com/voc/banking#> rdf:type owl:Ontology ;
                               owl:imports <https://schema.org/Finance.ttl> .

#################################################################
#    Classes (Entities)
#################################################################

###  Bank
:Bank rdf:type owl:Class ;
      rdfs:subClassOf schema:BankOrCreditUnion ;
      rdfs:comment "A financial institution that operates under regulations." .

###  Regulation
:Regulation rdf:type owl:Class ;
            rdfs:comment "A rule or directive made and maintained by an authority." .

###  Risk
:Risk rdf:type owl:Class ;
      rdfs:comment "A factor that may impact financial stability." .

###  LiquidityRisk
:LiquidityRisk rdf:type owl:Class ;
               rdfs:subClassOf :Risk ;
               rdfs:comment "The risk that an entity will not be able to meet its short-term obligations." .

###  CreditRisk
:CreditRisk rdf:type owl:Class ;
            rdfs:subClassOf :Risk ;
            rdfs:comment "The risk of default by a borrower." .

###  MarketRisk
:MarketRisk rdf:type owl:Class ;
            rdfs:subClassOf :Risk ;
            rdfs:comment "The risk of losses due to changes in market conditions." .

###  CounterpartyRisk
:CounterpartyRisk rdf:type owl:Class ;
                  rdfs:subClassOf :Risk ;
                  rdfs:comment "The risk associated with the other party in a financial transaction failing to meet their obligations." .

###  CapitalRequirement
:CapitalRequirement rdf:type owl:Class ;
                    rdfs:comment "A standard set by regulation determining the minimum capital a bank must hold." .

###  LiquidityStandard
:LiquidityStandard rdf:type owl:Class ;
                   rdfs:comment "A regulatory standard to ensure financial institutions have sufficient liquidity." .

###  StressTesting
:StressTesting rdf:type owl:Class ;
               rdfs:comment "A risk assessment process that evaluates financial resilience under adverse conditions." .

#################################################################
#    Object Properties (Relationships)
#################################################################

###  compliesWith (Bank → Regulation)
:compliesWith rdf:type owl:ObjectProperty ;
              rdfs:domain :Bank ;
              rdfs:range :Regulation ;
              rdfs:comment "Indicates that a bank complies with a given regulation." .

###  addresses (Regulation → Risk)
:addresses rdf:type owl:ObjectProperty ;
          rdfs:domain :Regulation ;
          rdfs:range :Risk ;
          rdfs:comment "Specifies that a regulation addresses a particular type of risk." .

###  setsCapitalRequirement (Regulation → CapitalRequirement)
:setsCapitalRequirement rdf:type owl:ObjectProperty ;
                        rdfs:domain :Regulation ;
                        rdfs:range :CapitalRequirement ;
                        rdfs:comment "Defines capital requirements set by a regulation." .

###  setsLiquidityStandard (Regulation → LiquidityStandard)
:setsLiquidityStandard rdf:type owl:ObjectProperty ;
                       rdfs:domain :Regulation ;
                       rdfs:range :LiquidityStandard ;
                       rdfs:comment "Defines liquidity standards set by a regulation." .

###  assessesRisk (StressTesting → Risk)
:assessesRisk rdf:type owl:ObjectProperty ;
              rdfs:domain :StressTesting ;
              rdfs:range :Risk ;
              rdfs:comment "Indicates that stress testing assesses a certain risk." .

###  managesCounterpartyRisk (Bank → CounterpartyRisk)
:managesCounterpartyRisk rdf:type owl:ObjectProperty ;
                         rdfs:domain :Bank ;
                         rdfs:range :CounterpartyRisk ;
                         rdfs:comment "Indicates that a bank manages counterparty risk." .

#################################################################
#    Data Properties (Entity Names)
#################################################################

###  Bank name
:bankName rdf:type owl:DatatypeProperty ;
          rdfs:domain :Bank ;
          rdfs:range xsd:string ;
          rdfs:comment "The name of the bank." .

###  Regulation name
:regulationName rdf:type owl:DatatypeProperty ;
                rdfs:domain :Regulation ;
                rdfs:range xsd:string ;
                rdfs:comment "The name of the regulation." .

###  Risk name
:riskName rdf:type owl:DatatypeProperty ;
          rdfs:domain :Risk ;
          rdfs:range xsd:string ;
          rdfs:comment "The name of the risk category." .
