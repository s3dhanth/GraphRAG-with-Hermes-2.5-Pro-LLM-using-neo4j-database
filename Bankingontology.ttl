@prefix : <http://neo4j.com/voc/banking#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix fibo-fbc-fct-fse: <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/> .
@prefix fibo-fnd-gao-obj: <https://spec.edmcouncil.org/fibo/ontology/FND/GoalsAndObjectives/> .
@prefix fibo-fnd-law-lcap: <https://spec.edmcouncil.org/fibo/ontology/FND/Law/LegalCore/> .
@prefix fibo-fbc-dae-cre: <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/CreditRisk/> .
@base <http://neo4j.com/voc/banking#> .

<http://neo4j.com/voc/banking#> rdf:type owl:Ontology ;
                             owl:imports <https://schema.org/version/latest/schemaorg-current-https.ttl> .

#################################################################
#    Classes
#################################################################

###  Bank
:Bank rdf:type owl:Class ;
      rdfs:subClassOf schema:FinancialService ;
      rdfs:comment "A financial institution that provides banking services and is regulated." .

###  Regulation
:Regulation rdf:type owl:Class ;
            rdfs:subClassOf fibo-fnd-law-lcap:Regulation ;
            rdfs:comment "A rule or directive enforced by a regulatory body." .

###  Risk
:Risk rdf:type owl:Class ;
      rdfs:subClassOf fibo-fnd-gao-obj:Risk ;
      rdfs:comment "A potential uncertainty or loss in financial operations." .

###  LiquidityRisk
:LiquidityRisk rdf:type owl:Class ;
              rdfs:subClassOf fibo-fbc-dae-cre:LiquidityRisk ;
              rdfs:comment "Risk arising from insufficient liquid assets to meet obligations." .

###  CreditRisk
:CreditRisk rdf:type owl:Class ;
           rdfs:subClassOf fibo-fbc-dae-cre:CreditRisk ;
           rdfs:comment "Risk of loss due to a borrower's inability to meet debt obligations." .

#################################################################
#    Object Properties (Relationships)
#################################################################

###  compliesWith (Bank → Regulation)
:compliesWith rdf:type owl:ObjectProperty ;
              rdfs:domain :Bank ;
              rdfs:range :Regulation ;
              rdfs:comment "Indicates that a bank complies with a regulation." .

###  addresses (Regulation → Risk)
:addresses rdf:type owl:ObjectProperty ;
           rdfs:domain :Regulation ;
           rdfs:range :Risk ;
           rdfs:comment "Regulation addresses a certain type of risk." .

###  assessesRisk (Bank → Risk)
:assessesRisk rdf:type owl:ObjectProperty ;
              rdfs:domain :Bank ;
              rdfs:range :Risk ;
              rdfs:comment "A bank evaluates and manages different types of risk." .

#################################################################
#    Data Properties
#################################################################

###  entityLabel (for better Neo4j integration)
:entityLabel rdf:type owl:DatatypeProperty ;
             rdfs:domain :Bank , :Regulation , :Risk , :LiquidityRisk , :CreditRisk ;
             rdfs:range xsd:string ;
             rdfs:comment "A human-readable label for entities in Neo4j." .
