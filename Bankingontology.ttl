@prefix : <http://www.semanticweb.org/ashut/ontologies/2025/3/banking#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

@base <http://www.semanticweb.org/ashut/ontologies/2025/3/banking#> .

<http://www.semanticweb.org/ashut/ontologies/2025/3/banking> rdf:type owl:Ontology .

#################################################################
#    Classes (Nodes)
#################################################################

###  Bank
:Bank rdf:type owl:Class ;
      rdfs:comment "A financial institution that operates under regulations." .

###  Regulation
:Regulation rdf:type owl:Class ;
            rdfs:comment "Rules and guidelines imposed by authorities to ensure financial stability." .

###  Risk
:Risk rdf:type owl:Class ;
      rdfs:comment "Potential threats or uncertainties affecting financial institutions." .

###  CapitalRequirement
:CapitalRequirement rdf:type owl:Class ;
                    rdfs:comment "The minimum amount of capital a bank must hold to reduce risk." .

###  LiquidityStandard
:LiquidityStandard rdf:type owl:Class ;
                   rdfs:comment "Regulatory requirement ensuring a bank has sufficient liquidity." .

#################################################################
#    Object Properties (Relationships)
#################################################################

###  COMPLIES_WITH
:compliesWith rdf:type owl:ObjectProperty ;
              rdfs:domain :Bank ;
              rdfs:range :Regulation ;
              rdfs:comment "A bank follows a regulation." .

###  ADDRESSES
:addresses rdf:type owl:ObjectProperty ;
           rdfs:domain :Regulation ;
           rdfs:range :Risk ;
           rdfs:comment "A regulation mitigates or controls a risk." .

###  SETS (for Capital Requirement)
:setsCapitalRequirement rdf:type owl:ObjectProperty ;
                        rdfs:domain :Regulation ;
                        rdfs:range :CapitalRequirement ;
                        rdfs:comment "A regulation defines the minimum capital requirement for banks." .

###  SETS (for Liquidity Standard)
:setsLiquidityStandard rdf:type owl:ObjectProperty ;
                       rdfs:domain :Regulation ;
                       rdfs:range :LiquidityStandard ;
                       rdfs:comment "A regulation establishes liquidity buffer requirements." .

#################################################################
#    Instances (Example Data)
#################################################################

### Example Bank
:BankA rdf:type owl:NamedIndividual , :Bank ;
       :compliesWith :RegulationX .

### Example Regulation
:RegulationX rdf:type owl:NamedIndividual , :Regulation ;
             :addresses :RiskA ;
             :setsCapitalRequirement :CapitalRequirementA ;
             :setsLiquidityStandard :LiquidityStandardA .

### Example Risk
:RiskA rdf:type owl:NamedIndividual , :Risk .

### Example Capital Requirement
:CapitalRequirementA rdf:type owl:NamedIndividual , :CapitalRequirement .

### Example Liquidity Standard
:LiquidityStandardA rdf:type owl:NamedIndividual , :LiquidityStandard .
